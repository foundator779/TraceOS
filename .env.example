# Local Gemini API access. Never commit the real value.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_VISION_MODEL=gemini-3.5-flash
GEMINI_USE_VERTEX=false

# Google Cloud deployment
GOOGLE_CLOUD_PROJECT=traceos-506713
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_LOCATION=global
GOOGLE_CLOUD_AGENT_ENGINE_ID=
GOOGLE_CLOUD_AGENT_ENGINE_LOCATION=northamerica-northeast1
ENABLE_CLOUD_CONNECTORS=false
ENABLE_MODEL_ARMOR=false
MODEL_ARMOR_TEMPLATE_ID=traceos-evidence
EVIDENCE_BUCKET=
PUBSUB_PUSH_AUDIENCE=
PUBSUB_PUSH_SERVICE_ACCOUNT=
AGENT_GATEWAY_STATUS=UNAVAILABLE_IN_PROJECT
DEMO_DAILY_RUN_LIMIT=20

# Protect generic write/upload endpoints. The bounded /demo/start action needs no key.
TRACEOS_API_KEY=
TRACEOS_DB_PATH=./data/traceos.db
TRACEOS_STORE=sqlite
RUNTIME_STEP_DELAY_MS=260

# Bonus models are isolated from the evidence plane and disabled by default.
ENABLE_GEMMA_VERIFIER=false
ENABLE_VEO_TRAINING=false
ENABLE_LYRIA_TRAINING=false
GEMMA_VERIFIER_MODEL=gemma-4-26b-a4b-it-maas
VEO_TRAINING_MODEL=veo-3.1-fast-generate-001
LYRIA_TRAINING_MODEL=lyria-3-clip-preview
TRAINING_MEDIA_LOCATION=us-central1
TRAINING_OUTPUT_BUCKET=
TRAINING_LOCAL_PATH=./data/training
TRAINING_BUDGET_USD=1.00
TRAINING_MAX_LIVE_RUNS=1
TRAINING_MAX_ARTIFACT_RETRIES=2
TRAINING_PUBSUB_TOPIC=
TRAINING_PUBSUB_AUDIENCE=
TRAINING_WORKER_SERVICE_ACCOUNT=
TRAINING_JOB_TIMEOUT_SECONDS=240
